# Get your free API key from:
# - DRPC: https://drpc.org (crypto-native, decentralized, easy signup via GitHub/Google)
# - QuickNode: https://www.quicknode.com/

# =============================================================================
# DRPC - Base Mainnet (RECOMMENDED)
# =============================================================================
RPC_WSS_URL=wss://lb.drpc.org/ogws?network=base&dkey=YOUR_DRPC_KEY

# =============================================================================
# Alternative: DRPC - Polygon Mainnet
# =============================================================================
# RPC_WSS_URL=wss://lb.drpc.org/ogws?network=polygon&dkey=YOUR_DRPC_KEY

# Logging level
RUST_LOG=info
